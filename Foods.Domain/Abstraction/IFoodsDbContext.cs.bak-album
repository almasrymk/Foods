namespace Foods.Domain.Abstraction
{
    using Microsoft.EntityFrameworkCore;
    using Foods.Domain.Entity.MasterData;
    using Foods.Domain.Entity.MasterData.Item;
    using Foods.Domain.Entity.MasterData.Content;
    using Foods.Domain.Entity.MasterData.TradeMark;
    
    public interface IFoodsDbContext: IDisposable 
    {
        DbSet<Content> Contents { get; set; }
        DbSet<ContentAlternative> ContentAlternatives { get; set; }
        DbSet<ContentCategory> ContentCategories { get; set; }
        DbSet<ContentGroup> ContentGroup { get; set; }
        DbSet<ContentLevel> ContentLevels { get; set; }
        DbSet<ContentPrice> ContentPrices { get; set; }
        DbSet<ContentTradeMark> ContentTradeMarks { get; set; }
        DbSet<Item> Items { get; set; }
        DbSet<ItemCategory> ItemCategories { get; set; }
        DbSet<ItemContent> ItemContents { get; set; }
        DbSet<ItemGroup> ItemGroups { get; set; }
        DbSet<ItemLevel> ItemLevels { get; set; }
        DbSet<ItemMeal> ItemMeals { get; set; }
        DbSet<ItemCountry> ItemCountries { get; set; }
        DbSet<TradeMark> TradeMarks { get; set; }
        DbSet<TradeMarkContentGroup> TradeMarkContentGroups { get; set; }
        DbSet<Level> Levels { get; set; }
        DbSet<Country> Countries { get; set; }
        DbSet<Meal> Meals { get; set; }
        DbSet<Cuisine> Cuisines { get; set; }
        DbSet<Unit> Units { get; set; }
        DbSet<PurchasePlace> PurchasePlaces { get; set; }
        DbSet<AgeBand> AgeBands { get; set; }
        DbSet<ItemStep> ItemSteps { get; set; }
        DbSet<ItemVideo> ItemVideos { get; set; }
        DbSet<TEntity> Set<TEntity>() where TEntity : class;

        int SaveChanges();
        Task<int> SaveChangesAsync(CancellationToken cancellationToken = default);
    }
}