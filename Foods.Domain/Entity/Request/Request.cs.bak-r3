namespace Foods.Domain.Entity.Request
{
    public class Request : BaseEntity
    {
        public Guid ServiceId { get; set; } 
        public Guid UserId { get; set; }
        public Guid CurrentStepId { get; set; }
        public string? Code { get; set; }
        public string? Name { get; set; }
        public DateTime Date { get; set; }
        public string? Notes { get; set; }
        /// <summary>When the order was created (used to sort newest first).</summary>
        public DateTime? CreatedAt { get; set; }
        /// <summary>Last time the purchase order was printed (null = never printed).</summary>
        public DateTime? PrintedAt { get; set; }
        /// <summary>Last time the user re-ordered it (null = never re-ordered).</summary>
        public DateTime? ReorderedAt { get; set; }
        /// <summary>Last time the order was shared (null = never shared).</summary>
        public DateTime? SharedAt { get; set; }
    }
}