import { Component, OnDestroy, OnInit } from '@angular/core';
import { Router } from '@angular/router';
import { Subscription } from 'rxjs';
import { ApiService } from '../../../core/api.service';
import { NotificationsService } from '../../../core/notifications.service';
import { AppNotification } from '../../../core/models';
import { FaScreenHeaderComponent } from '../shared/screen-header.component';
import { FaTabBarComponent } from '../shared/tab-bar.component';
import { FaIconComponent } from '../shared/icon.component';

type Tab = 'all' | 'unread' | 'read';

const PAGE = 20;

/** Icon and colours per notification type. */
const TYPES: Record<string, { icon: string; color: string; bg: string }> = {
  login_reminder: { icon: 'bell', color: '#F37202', bg: '#FEEBD6' },
  welcome_back: { icon: 'home', color: '#2F7D1E', bg: '#E3F1DB' },
  birthday: { icon: 'cake', color: '#C2416B', bg: '#FCE1EA' },
  order_reminder: { icon: 'receipt', color: '#6B4AA8', bg: '#ECE4F7' },
  weekly_plan: { icon: 'calendar', color: '#1F6FB2', bg: '#E1EEF9' }
};
const FALLBACK = { icon: 'bell', color: '#F37202', bg: '#FEEBD6' };

/** الإشعارات: every notification, with all / unread / read tabs (20 per page). */
@Component({
  selector: 'app-notifications-screen',
  imports: [FaScreenHeaderComponent, FaTabBarComponent, FaIconComponent],
  template: `
    <div class="fa-screen nt" dir="rtl">
      <fa-screen-header title="الإشعارات" titleIcon="bell" subtitle="تذكيرات وتهاني وأخبار طلباتك في مكان واحد" [height]="210" [titleY]="157" [backY]="120" />

      <div class="bar">
        <div class="fa-chips tabs" role="tablist">
          @for (t of tabs; track t.key) {
            <button type="button" class="fa-chip" role="tab" [class.on]="tab === t.key" [attr.aria-selected]="tab === t.key" (click)="select(t.key)">
              {{ t.label }}@if (t.key === 'unread' && unread) { <b class="cnt">{{ unread }}</b> }
            </button>
          }
        </div>
        <button type="button" class="read-all" [disabled]="!unread || busy" (click)="readAll()">
          <fa-icon name="check" [weight]="2.4" />تحديد الكل كمقروء
        </button>
      </div>

      <div class="list">
        @for (n of items; track n.id) {
          <button type="button" class="item" [class.unread]="!n.readAt" (click)="open(n)">
            <span class="ico" [style.background]="kind(n).bg" [style.color]="kind(n).color"><fa-icon [name]="kind(n).icon" [weight]="2" /></span>
            <span class="txt">
              <b class="ttl">{{ n.title }}</b>
              <span class="body">{{ n.body }}</span>
              <small class="when">{{ ago(n.createdAt) }}</small>
            </span>
            @if (!n.readAt) { <i class="dot" aria-label="غير مقروء"></i> }
          </button>
        }
        @if (!loading && !items.length) {
          <div class="empty">
            <fa-icon name="bell" [weight]="1.6" />
            <p>{{ tab === 'unread' ? 'مفيش إشعارات جديدة' : tab === 'read' ? 'مفيش إشعارات مقروءة' : 'مفيش إشعارات لسه' }}</p>
          </div>
        }
        @if (loading) { <div class="loading">جاري التحميل...</div> }
        @if (!loading && items.length < total) {
          <button type="button" class="more" (click)="load(false)">عرض المزيد</button>
        }
        @if (error) { <p class="err">{{ error }}</p> }
      </div>
      <fa-tab-bar />
    </div>
  `,
  styles: [`
    .bar {
      display: flex; align-items: center; justify-content: space-between; gap: calc(16 * var(--s));
      margin: calc(48 * var(--s)) calc(36 * var(--s)) 0;
    }
    .tabs { margin: 0 !important; justify-content: flex-start !important; flex-wrap: nowrap; }
    .tabs .fa-chip { height: calc(60 * var(--s)); gap: calc(8 * var(--s)); }
    .cnt {
      min-width: calc(32 * var(--s)); height: calc(32 * var(--s)); padding: 0 calc(8 * var(--s)); border-radius: calc(16 * var(--s));
      display: inline-grid; place-items: center; background: #E5262A; color: #fff; font-size: calc(19 * var(--s)); font-weight: 800;
    }
    .read-all {
      display: flex; align-items: center; gap: calc(8 * var(--s)); white-space: nowrap;
      color: #C45A00; font-size: calc(23 * var(--s)); font-weight: 800;
    }
    .read-all fa-icon { font-size: calc(28 * var(--s)); }
    .read-all:disabled { opacity: .4; cursor: default; }
    .list { display: flex; flex-direction: column; gap: calc(18 * var(--s)); margin: calc(26 * var(--s)) calc(36 * var(--s)) 0; }
    .item {
      position: relative; display: flex; align-items: flex-start; gap: calc(22 * var(--s)); width: 100%;
      padding: calc(22 * var(--s)) calc(24 * var(--s)); text-align: right !important;
      border-radius: calc(24 * var(--s)); background: #FFFCF8; border: calc(1.5 * var(--s)) solid #F2E6D8;
      box-shadow: 0 calc(4 * var(--s)) calc(14 * var(--s)) rgba(120, 72, 30, .07);
    }
    .item.unread { background: #FFF4E6; border-color: #F9CF9F; box-shadow: 0 calc(5 * var(--s)) calc(16 * var(--s)) rgba(243, 114, 2, .12); }
    .ico {
      flex: none; width: calc(78 * var(--s)); height: calc(78 * var(--s)); border-radius: 50%;
      display: grid; place-items: center; font-size: calc(40 * var(--s));
    }
    .txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: calc(6 * var(--s)); }
    .ttl { font-size: calc(29 * var(--s)); font-weight: 800; color: #2E1E12; line-height: 1.3; }
    .item:not(.unread) .ttl { font-weight: 700; color: #4A3A2E; }
    .body { font-size: calc(24 * var(--s)); color: #5E5148; line-height: 1.45; }
    .when { font-size: calc(20 * var(--s)); color: #9A8B7E; }
    .dot {
      position: absolute; left: calc(24 * var(--s)); top: calc(26 * var(--s));
      width: calc(16 * var(--s)); height: calc(16 * var(--s)); border-radius: 50%; background: #F37202;
    }
    .empty { display: flex; flex-direction: column; align-items: center; gap: calc(14 * var(--s)); padding: calc(80 * var(--s)) 0; color: #B3A496; }
    .empty fa-icon { font-size: calc(90 * var(--s)); }
    .empty p { font-size: calc(27 * var(--s)); font-weight: 700; color: #8A7A6E; }
    .loading { text-align: center; padding: calc(30 * var(--s)); color: #8A7A6E; font-size: calc(24 * var(--s)); }
    .more {
      align-self: center; padding: calc(14 * var(--s)) calc(40 * var(--s)); border-radius: calc(30 * var(--s));
      background: #FBF1E4 !important; color: #C45A00; font-size: calc(24 * var(--s)); font-weight: 800;
    }
    .err { text-align: center; color: #B71C1C; font-size: calc(24 * var(--s)); }
  `]
})
export class NotificationsScreenComponent implements OnInit, OnDestroy {
  readonly tabs: { key: Tab; label: string }[] = [
    { key: 'all', label: 'الكل' },
    { key: 'unread', label: 'غير مقروءة' },
    { key: 'read', label: 'مقروءة' }
  ];
  tab: Tab = 'all';
  items: AppNotification[] = [];
  total = 0;
  unread = 0;
  loading = false;
  busy = false;
  error = '';
  private sub?: Subscription;

  constructor(private api: ApiService, private notifications: NotificationsService, private router: Router) {}

  ngOnInit(): void {
    this.load(true);
  }

  ngOnDestroy(): void {
    this.sub?.unsubscribe();
  }

  select(tab: Tab): void {
    if (tab === this.tab) return;
    this.tab = tab;
    this.load(true);
  }

  load(reset: boolean): void {
    if (reset) { this.sub?.unsubscribe(); this.items = []; this.total = 0; }
    this.loading = true;
    this.error = '';
    const unread = this.tab === 'all' ? null : this.tab === 'unread';
    this.sub = this.api.notifications(this.items.length, PAGE, unread).subscribe({
      next: page => {
        this.items = [...this.items, ...page.items];
        this.total = page.total;
        this.unread = page.unread;
        this.notifications.set(page.unread);
        this.loading = false;
      },
      error: (e: Error) => { this.loading = false; this.error = e.message; }
    });
  }

  open(n: AppNotification): void {
    const go = () => { if (n.link) this.router.navigateByUrl(n.link); };
    if (n.readAt) { go(); return; }
    this.api.markNotificationRead(n.id).subscribe({
      next: unread => {
        n.readAt = new Date().toISOString();
        this.unread = unread;
        this.notifications.set(unread);
        go();
      },
      error: () => go()
    });
  }

  readAll(): void {
    this.busy = true;
    this.api.markAllNotificationsRead().subscribe({
      next: () => {
        this.busy = false;
        this.notifications.set(0);
        this.load(true);
      },
      error: (e: Error) => { this.busy = false; this.error = e.message; }
    });
  }

  kind(n: AppNotification) {
    return TYPES[n.type] || FALLBACK;
  }

  /** Relative Arabic time: "الآن", "منذ 5 دقائق", "منذ ساعتين", "أمس"... */
  ago(iso: string): string {
    const t = new Date(iso.endsWith('Z') || /[+-]\d\d:\d\d$/.test(iso) ? iso : iso + 'Z').getTime();
    const sec = Math.max(0, Math.round((Date.now() - t) / 1000));
    const min = Math.round(sec / 60), hr = Math.round(sec / 3600), day = Math.round(sec / 86400);
    const unit = (n: number, one: string, two: string, few: string, many: string) =>
      n === 1 ? one : n === 2 ? two : n <= 10 ? `${n} ${few}` : `${n} ${many}`;
    if (sec < 60) return 'الآن';
    if (min < 60) return 'منذ ' + unit(min, 'دقيقة', 'دقيقتين', 'دقائق', 'دقيقة');
    if (hr < 24) return 'منذ ' + unit(hr, 'ساعة', 'ساعتين', 'ساعات', 'ساعة');
    if (day === 1) return 'أمس';
    if (day < 7) return 'منذ ' + unit(day, 'يوم', 'يومين', 'أيام', 'يوم');
    if (day < 30) { const w = Math.round(day / 7); return 'منذ ' + unit(w, 'أسبوع', 'أسبوعين', 'أسابيع', 'أسبوع'); }
    return new Date(t).toLocaleDateString('ar-EG', { day: 'numeric', month: 'long', year: 'numeric' });
  }
}
