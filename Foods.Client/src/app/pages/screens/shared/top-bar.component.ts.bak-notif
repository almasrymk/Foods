import { Component, Input } from '@angular/core';
import { RouterLink } from '@angular/router';
import { FaLogoComponent } from './logo.component';

/**
 * The app's top bar, copied from the home page header: account avatar (left),
 * logo (centre) and notifications bell with its badge (right).
 * Sizes are home-page design px (841px mockup): calc(X * var(--u)).
 * Drop it at the top of any screen; it is in normal flow and takes its own height.
 */
@Component({
  selector: 'fa-top-bar',
  imports: [RouterLink, FaLogoComponent],
  template: `
    <div class="tp" dir="rtl">
      <a class="tp-profile" routerLink="/settings" aria-label="الحساب">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      </a>
      <i class="tp-dot"></i>
      <a class="tp-logo" routerLink="/home" aria-label="الرئيسية"><fa-logo /></a>
      <a class="tp-bell" routerLink="/orders" aria-label="التنبيهات">
        <svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/></svg>
      </a>
      @if (badge) { <b class="tp-badge">{{ badge }}</b> }
    </div>
  `,
  styles: [`
    :host {
      display: block;
      --u: calc(var(--fa-w) / 841);
      font-family: 'Tajawal', 'Cairo', sans-serif;
    }
    .tp { position: relative; height: calc(128 * var(--u)); }
    .tp a { color: inherit; text-decoration: none; }
    .tp svg { display: block; fill: currentColor; }
    .tp-profile {
      position: absolute; left: calc(29 * var(--u)); top: calc(29 * var(--u));
      width: calc(92 * var(--u)); height: calc(92 * var(--u)); border-radius: 50%;
      background: #fff; box-shadow: 0 calc(4 * var(--u)) calc(16 * var(--u)) rgba(0, 0, 0, .08);
      display: grid; place-items: center; color: #4A2A12;
    }
    .tp-profile svg { width: calc(62 * var(--u)); height: calc(62 * var(--u)); }
    .tp-dot {
      position: absolute; left: calc(100 * var(--u)); top: calc(34 * var(--u));
      width: calc(12 * var(--u)); height: calc(12 * var(--u)); border-radius: 50%; background: #F37202;
    }
    .tp-logo {
      position: absolute; left: calc(367 * var(--u)); top: calc(8 * var(--u));
      width: calc(130 * var(--u)); height: calc(112 * var(--u));
    }
    .tp-logo fa-logo { width: 100%; height: 100%; }
    .tp-bell { position: absolute; left: calc(740 * var(--u)); top: calc(52 * var(--u)); color: #2E1E12; }
    .tp-bell svg { width: calc(56 * var(--u)); height: calc(56 * var(--u)); }
    .tp-badge {
      position: absolute; left: calc(777 * var(--u)); top: calc(45 * var(--u));
      width: calc(27 * var(--u)); height: calc(27 * var(--u)); border-radius: 50%;
      background: #E5262A; color: #fff; display: grid; place-items: center;
      font-size: calc(18 * var(--u)); font-weight: 700; line-height: 1.1; pointer-events: none;
    }
  `]
})
export class FaTopBarComponent {
  /** Unread notifications count shown on the bell (0 hides it). */
  @Input() badge = 3;
}
