/* Same layout and tile language as the meals plan screen ("اختر نوع الوجبة"), in mockup px (941 wide): calc(N * var(--s)). */
.cu { background: #FDF8F3; }
.cu button { font-family: inherit; }

/* ---------- header (plan screen positions, shifted up under the shared top bar) */
.cu-head { position: relative; height: calc(300 * var(--s)); margin-top: calc(-30 * var(--s)); }
.cu-art[src$=".svg"] { object-fit: contain !important; -webkit-mask-image: none !important; mask-image: none !important; }
.cu-art {
  position: absolute; left: 0; top: 0; width: calc(356 * var(--s)); height: calc(292 * var(--s)); object-fit: cover;
  -webkit-mask-image: linear-gradient(90deg, #000 78%, transparent), linear-gradient(180deg, transparent, #000 8%, #000 85%, transparent);
  -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, #000 78%, transparent), linear-gradient(180deg, transparent, #000 8%, #000 85%, transparent); mask-composite: intersect;
}
.cu-fork { position: absolute; left: calc(832 * var(--s)); top: calc(74 * var(--s)); width: calc(72 * var(--s)); height: calc(76 * var(--s)); }
.cu-title {
  position: absolute; right: calc(131 * var(--s)); top: calc(110 * var(--s)); transform: translateY(-50%);
  font-size: calc(58 * var(--s)); font-weight: 800; color: #2E1E12; white-space: nowrap; margin: 0;
}
.cu-underline { position: absolute; left: calc(560 * var(--s)); top: calc(138 * var(--s)); width: calc(68 * var(--s)); height: calc(22 * var(--s)); }
.cu-sub {
  position: absolute; right: calc(51 * var(--s)); top: calc(192 * var(--s)); transform: translateY(-50%);
  font-size: calc(24 * var(--s)); font-weight: 500; color: #3F3129; white-space: nowrap; margin: 0;
}

/* ---------- tiles: 3 columns like the plan screen (278 wide, 19 gap) */
.cu-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  column-gap: calc(19 * var(--s)); row-gap: calc(22 * var(--s));
  margin: calc(10 * var(--s)) calc(36 * var(--s)) 0 calc(35 * var(--s));
}
.cu-tile {
  height: calc(283 * var(--s)); border: 0; padding: calc(12 * var(--s)) 0 0; cursor: pointer;
  border-radius: calc(28 * var(--s)); overflow: hidden;
  display: flex; flex-direction: column; align-items: center;
  background: #FFF3E6;
  box-shadow: 0 calc(5 * var(--s)) calc(14 * var(--s)) rgba(120, 72, 30, .1);
  outline: calc(3 * var(--s)) solid transparent; outline-offset: calc(-3 * var(--s)); transition: outline-color .15s;
  color: #2E1E12;
}
.cu-tile:active { outline-color: #F37202; }
.cu-tile-ico {
  width: calc(48 * var(--s)); height: calc(48 * var(--s)); flex: none;
  display: grid; place-items: center; font-size: calc(42 * var(--s)); overflow: hidden; border-radius: 50%;
}
.cu-tile-ico img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.5); }
.cu-tile b {
  margin: calc(2 * var(--s)) 0 0; text-align: center; max-width: 92%;
  font-size: calc(34 * var(--s)); font-weight: 800; line-height: 1.1;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.cu-tile-art {
  position: relative; flex: 1; align-self: stretch; min-height: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: calc(8 * var(--s));
}
.cu-tile-art::before {
  content: ''; position: absolute; left: 50%; bottom: calc(-70 * var(--s)); transform: translateX(-50%);
  width: calc(300 * var(--s)); height: calc(200 * var(--s)); border-radius: 50%;
  background: rgba(255, 255, 255, .45);
}
.cu-tile-circle {
  position: relative; width: calc(112 * var(--s)); height: calc(112 * var(--s)); border-radius: 50%;
  display: grid; place-items: center; overflow: hidden; background: #fff;
  box-shadow: 0 calc(4 * var(--s)) calc(12 * var(--s)) rgba(0, 0, 0, .08);
  font-size: calc(64 * var(--s));
}
.cu-tile-circle img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.4); }
.cu-tile-art small {
  position: relative; height: calc(38 * var(--s)); padding: 0 calc(16 * var(--s));
  display: grid; place-items: center; border-radius: calc(19 * var(--s));
  background: rgba(255, 255, 255, .8); font-size: calc(22 * var(--s)); font-weight: 800; white-space: nowrap;
}

/* the "all" tile */
.cu-tile.all { background: linear-gradient(180deg, #FF9A1F, #F37202); color: #fff; }
.cu-tile.all .cu-tile-circle { color: #F37202; }
.cu-tile.all .cu-tile-art small { color: #E2640A; }

.cu-skel {
  cursor: default;
  background: linear-gradient(90deg, #F6ECE1 25%, #FBF4EC 50%, #F6ECE1 75%) !important;
  background-size: 200% 100% !important;
  animation: cu-shimmer 1.2s linear infinite;
}
@keyframes cu-shimmer { from { background-position: 200% 0; } to { background-position: 0 0; } }

.cu-empty { margin: calc(60 * var(--s)) 0 0; text-align: center; color: #8A6A4A; font-size: calc(28 * var(--s)); font-weight: 700; }
