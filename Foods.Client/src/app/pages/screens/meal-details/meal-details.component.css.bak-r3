/* This mockup is 958px wide, so --s is redefined; all sizes are its pixels. */
.md { --s: calc(var(--fa-w) / 958); background: #FDF6F1; }
.md-cv { position: relative; min-height: calc(1490 * var(--s)); margin-top: calc(-85 * var(--s)); }
/* back button sits beside the title, below the shared top bar */
.md-back { top: calc(98 * var(--s)) !important; }

.md-corner { position: absolute; left: 0; top: 0; width: calc(185 * var(--s)); height: calc(112 * var(--s)); }
.md-logo { position: absolute; left: calc(418 * var(--s)); top: 0; width: calc(122 * var(--s)); height: calc(105 * var(--s)); }
.md-back {
  position: absolute; left: calc(850 * var(--s)); top: calc(42 * var(--s)); width: calc(65 * var(--s)); height: calc(65 * var(--s));
  display: grid; place-items: center; border-radius: calc(18 * var(--s)); background: #FFFCF8; color: #2E1E12;
  box-shadow: 0 calc(4 * var(--s)) calc(14 * var(--s)) rgba(120, 72, 30, .13); font-size: calc(36 * var(--s));
}
.md-title {
  position: absolute; left: 0; right: 0; top: calc(130 * var(--s)); transform: translateY(-50%);
  display: flex; justify-content: center; align-items: center; gap: calc(16 * var(--s));
}
.md-title h1 { font-size: calc(40 * var(--s)); font-weight: 800; color: #3A2412; white-space: nowrap; }
.md-dash { width: calc(60 * var(--s)); height: calc(20 * var(--s)); }
.md-flip { transform: scaleX(-1); }

.md-video {
  position: absolute; left: calc(33 * var(--s)); top: calc(165 * var(--s)); width: calc(449 * var(--s)); height: calc(241 * var(--s));
  border-radius: calc(22 * var(--s)); overflow: hidden; box-shadow: 0 calc(6 * var(--s)) calc(16 * var(--s)) rgba(0, 0, 0, .15);
}
.md-video img { width: 100%; height: 100%; object-fit: cover; }
.md-tag {
  position: absolute; right: calc(36 * var(--s)); top: calc(165 * var(--s)); height: calc(36 * var(--s)); padding: 0 calc(18 * var(--s));
  display: flex; align-items: center; gap: calc(10 * var(--s)); border-radius: calc(18 * var(--s));
  background: #E6F2D6; color: #2F7D1E; font-size: calc(25 * var(--s)); font-weight: 800;
}
.md-tag fa-icon { font-size: calc(32 * var(--s)); }
.md-name { position: absolute; right: calc(38 * var(--s)); top: calc(203 * var(--s)); font-size: calc(48 * var(--s)); font-weight: 800; color: #1F140C; white-space: nowrap; }
.md-desc {
  position: absolute; right: calc(38 * var(--s)); top: calc(266 * var(--s)); width: calc(390 * var(--s));
  font-size: calc(26 * var(--s)); font-weight: 700; color: #6E6A66; line-height: 1.2;
}
.md-facts { position: absolute; right: calc(30 * var(--s)); top: calc(350 * var(--s)); display: flex; gap: calc(16 * var(--s)); }
.md-facts span {
  height: calc(52 * var(--s)); padding: 0 calc(18 * var(--s)); display: flex; align-items: center; gap: calc(10 * var(--s));
  border-radius: calc(26 * var(--s)); background: #FFFCF9; box-shadow: 0 calc(3 * var(--s)) calc(10 * var(--s)) rgba(120, 72, 30, .1);
  font-size: calc(23 * var(--s)); font-weight: 800; color: #2E1E12; white-space: nowrap;
}
.md-facts fa-icon { font-size: calc(36 * var(--s)); color: #F37202; }

.md-actions {
  position: absolute; left: calc(25 * var(--s)); right: calc(23 * var(--s)); top: calc(432 * var(--s)); height: calc(88 * var(--s));
  border-radius: calc(44 * var(--s)); background: #FFFCF9; box-shadow: 0 calc(5 * var(--s)) calc(18 * var(--s)) rgba(120, 72, 30, .1);
}
.md-plan {
  position: absolute; right: calc(17 * var(--s)); top: calc(15 * var(--s)); width: calc(320 * var(--s)); height: calc(58 * var(--s));
  display: flex; align-items: center; justify-content: center; gap: calc(16 * var(--s)); border-radius: calc(29 * var(--s));
  background: linear-gradient(90deg, #FF8A12, #F35E02); color: #fff; font-size: calc(28 * var(--s)); font-weight: 800;
  box-shadow: 0 calc(4 * var(--s)) calc(10 * var(--s)) rgba(243, 94, 2, .3);
}
.md-plan fa-icon { font-size: calc(42 * var(--s)); }
.md-qty { position: absolute; left: calc(328 * var(--s)); top: calc(15 * var(--s)); width: calc(209 * var(--s)); height: calc(58 * var(--s)); background: #E8F2D8; }
.md-qty b { min-width: calc(76 * var(--s)); height: calc(52 * var(--s)); font-size: calc(36 * var(--s)); }
.md-vl { position: absolute; left: calc(286 * var(--s)); top: calc(22 * var(--s)); width: calc(2 * var(--s)); height: calc(44 * var(--s)); background: #E3D6C8; }
.md-fav {
  position: absolute; left: calc(40 * var(--s)); top: calc(15 * var(--s)); height: calc(58 * var(--s));
  display: flex; align-items: center; gap: calc(14 * var(--s)); font-size: calc(26 * var(--s)); font-weight: 800; color: #2E1E12;
}
.md-fav fa-icon { font-size: calc(44 * var(--s)); color: #F37202; }

.md-card {
  position: absolute; left: calc(25 * var(--s)); right: calc(23 * var(--s)); border-radius: calc(30 * var(--s));
  background: rgba(255, 252, 249, .85); box-shadow: 0 calc(5 * var(--s)) calc(18 * var(--s)) rgba(120, 72, 30, .08);
}
.md-pill {
  position: absolute; right: calc(25 * var(--s)); top: calc(17 * var(--s)); height: calc(48 * var(--s));
  display: flex; align-items: center; justify-content: center; gap: calc(14 * var(--s));
  border-radius: calc(24 * var(--s)); background: linear-gradient(90deg, #FF8A12, #F35E02); color: #fff;
  font-size: calc(30 * var(--s)); font-weight: 800; white-space: nowrap;
}
.md-pill fa-icon { font-size: calc(38 * var(--s)); }
.md-sdash { position: absolute; top: calc(32 * var(--s)); width: calc(66 * var(--s)); height: calc(20 * var(--s)); }

.md-ing { top: calc(540 * var(--s)); height: calc(335 * var(--s)); }
.md-irow {
  position: absolute; right: calc(25 * var(--s)); width: calc(402 * var(--s)); height: calc(62 * var(--s));
  border-radius: calc(31 * var(--s)); background: #FFFCF9; box-shadow: 0 calc(3 * var(--s)) calc(10 * var(--s)) rgba(120, 72, 30, .08);
}
.md-irow.md-left { right: auto; left: calc(23 * var(--s)); width: calc(397 * var(--s)); }
.md-irow img { position: absolute; right: calc(15 * var(--s)); top: calc(1 * var(--s)); width: calc(95 * var(--s)); height: calc(60 * var(--s)); object-fit: contain; }
.md-irow .md-ipic { position: absolute; right: calc(15 * var(--s)); top: calc(1 * var(--s)); width: calc(95 * var(--s)); height: calc(60 * var(--s)); }
.md-irow b { position: absolute; right: calc(137 * var(--s)); top: calc(4 * var(--s)); font-size: calc(23 * var(--s)); font-weight: 800; color: #2E1E12; white-space: nowrap; }
.md-irow span { position: absolute; right: calc(137 * var(--s)); top: calc(32 * var(--s)); font-size: calc(21 * var(--s)); font-weight: 800; color: #2F8A1E; white-space: nowrap; }
.md-col { position: absolute; left: calc(452 * var(--s)); top: calc(95 * var(--s)); width: calc(1.5 * var(--s)); height: calc(215 * var(--s)); background: #E8DCCF; }

.md-steps { top: calc(895 * var(--s)); height: calc(310 * var(--s)); }
.md-steps .md-pill { top: calc(27 * var(--s)); }
.md-steps .md-sdash { top: calc(42 * var(--s)); }
.md-steps ol {
  position: absolute; left: calc(23 * var(--s)); right: calc(25 * var(--s)); top: calc(85 * var(--s));
  margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: calc(4 * var(--s));
}
.md-steps li {
  position: relative; min-height: calc(44 * var(--s)); padding: calc(3 * var(--s)) calc(105 * var(--s)) calc(3 * var(--s)) calc(10 * var(--s));
  display: flex; align-items: center; border-radius: calc(23 * var(--s)); background: #FFFCF9;
  box-shadow: 0 calc(3 * var(--s)) calc(10 * var(--s)) rgba(120, 72, 30, .07);
  font-size: calc(20 * var(--s)); font-weight: 800; color: #1F140C; line-height: 1.25; letter-spacing: -.01em;
}
.md-steps li i {
  position: absolute; right: calc(20 * var(--s)); top: 50%; transform: translateY(-50%);
  width: calc(42 * var(--s)); height: calc(42 * var(--s)); border-radius: 50%; display: grid; place-items: center;
  background: linear-gradient(180deg, #FF9A1F, #F36202); color: #fff; font-style: normal; font-size: calc(26 * var(--s)); font-weight: 800;
}

.md-videos { top: calc(1222 * var(--s)); height: calc(246 * var(--s)); }
.md-videos .md-pill { top: calc(16 * var(--s)); }
.md-videos .md-sdash { top: calc(31 * var(--s)); }
.md-thumbs { position: absolute; left: calc(16 * var(--s)); right: calc(20 * var(--s)); top: calc(80 * var(--s)); display: flex; gap: calc(16 * var(--s)); }
.md-thumb { flex: 1; display: block; }
.md-thumb img { width: 100%; height: calc(121 * var(--s)); border-radius: calc(16 * var(--s)); object-fit: cover; }
.md-thumb b { display: block; margin-top: calc(10 * var(--s)); text-align: center; font-size: calc(23 * var(--s)); font-weight: 800; color: #1F140C; white-space: nowrap; }

/* ---------- cards below the actions flow from the design top (540): identical positions, they only grow ---------- */
.md-flow {
  position: relative; display: flex; flex-direction: column;
  padding-top: calc(540 * var(--s)); padding-bottom: calc(22 * var(--s));
  pointer-events: none; /* the empty top area must not cover the hero buttons */
}
.md-flow > .md-card { position: relative; top: auto; left: auto; right: auto; margin: 0 calc(23 * var(--s)) 0 calc(25 * var(--s)); pointer-events: auto; }
.md-flow > .md-steps { margin-top: calc(20 * var(--s)); height: auto; min-height: calc(310 * var(--s)); padding: calc(85 * var(--s)) calc(25 * var(--s)) calc(20 * var(--s)) calc(23 * var(--s)); box-sizing: border-box; }
.md-flow > .md-steps ol { position: static; }
.md-flow > .md-videos { margin-top: calc(17 * var(--s)); }
.md-steps li.md-empty { padding-right: calc(20 * var(--s)); color: #8B7B6C; }

/* personal version */
.md-mine { position: absolute; left: calc(25 * var(--s)); top: calc(21 * var(--s)); display: flex; align-items: center; gap: calc(10 * var(--s)); }
.md-mine-btn {
  height: calc(40 * var(--s)); padding: 0 calc(16 * var(--s)); border-radius: calc(20 * var(--s));
  background: #FFF1E3; color: #E25F02; box-shadow: inset 0 0 0 1px #F7C79B;
  font-size: calc(19 * var(--s)); font-weight: 800; white-space: nowrap; cursor: pointer;
}
.md-mine-btn:disabled { opacity: .6; }
.md-mine-badge {
  height: calc(34 * var(--s)); padding: 0 calc(12 * var(--s)); border-radius: calc(17 * var(--s));
  display: inline-flex; align-items: center; background: #EAF4D9; color: #2F7D1E;
  font-size: calc(17 * var(--s)); font-weight: 800; white-space: nowrap;
}
.md-irow.md-mark { box-shadow: inset 0 0 0 calc(2 * var(--s)) #BFE29B, 0 calc(3 * var(--s)) calc(10 * var(--s)) rgba(120, 72, 30, .08); }
.md-none { position: absolute; left: 0; right: 0; top: calc(140 * var(--s)); margin: 0; text-align: center; font-size: calc(22 * var(--s)); font-weight: 700; color: #8B7B6C; }

.md-ing.md-editing { height: auto; padding: calc(85 * var(--s)) calc(23 * var(--s)) calc(22 * var(--s)) calc(25 * var(--s)); box-sizing: border-box; }
.md-edit { display: flex; flex-direction: column; gap: calc(10 * var(--s)); }
.md-erow {
  display: grid; grid-template-columns: calc(80 * var(--s)) 1fr calc(130 * var(--s)) calc(150 * var(--s)) calc(56 * var(--s));
  align-items: center; gap: calc(12 * var(--s)); min-height: calc(66 * var(--s)); padding: calc(4 * var(--s)) calc(12 * var(--s));
  border-radius: calc(33 * var(--s)); background: #FFFCF9; box-shadow: 0 calc(3 * var(--s)) calc(10 * var(--s)) rgba(120, 72, 30, .08);
}
.md-erow.md-new { box-shadow: inset 0 0 0 calc(2 * var(--s)) #BFE29B; }
.md-erow img { width: 100%; height: calc(56 * var(--s)); object-fit: contain; }
.md-erow b { font-size: calc(23 * var(--s)); font-weight: 800; color: #2E1E12; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.md-erow input, .md-erow select, .md-picker input, .md-estep textarea {
  width: 100%; min-width: 0; box-sizing: border-box; height: calc(48 * var(--s)); padding: 0 calc(12 * var(--s));
  border: 0; border-radius: calc(14 * var(--s)); background: #fff; box-shadow: inset 0 0 0 1px #EADBC9;
  font: inherit; font-size: calc(21 * var(--s)); font-weight: 700; color: #2E1E12;
}
.md-erow input { text-align: center; direction: ltr; }
.md-trash {
  width: calc(48 * var(--s)); height: calc(48 * var(--s)); border-radius: 50%; display: grid; place-items: center;
  background: #FDE8E8; color: #C0392B; font-size: calc(24 * var(--s)); cursor: pointer; padding: 0; border: 0;
}
.md-removed { display: flex; flex-wrap: wrap; align-items: center; gap: calc(8 * var(--s)); font-size: calc(19 * var(--s)); font-weight: 700; color: #8B7B6C; }
.md-removed button {
  height: calc(36 * var(--s)); padding: 0 calc(12 * var(--s)); border-radius: calc(18 * var(--s));
  background: #F4ECE3; color: #6B5646; font-size: calc(18 * var(--s)); font-weight: 700; cursor: pointer;
}
.md-add {
  align-self: flex-start; height: calc(46 * var(--s)); padding: 0 calc(20 * var(--s)); border-radius: calc(23 * var(--s));
  background: #EAF4D9; color: #2F7D1E; font-size: calc(21 * var(--s)); font-weight: 800; cursor: pointer;
}
.md-picker { display: flex; flex-direction: column; gap: calc(8 * var(--s)); padding: calc(12 * var(--s)); border-radius: calc(22 * var(--s)); background: #FFF8F0; box-shadow: inset 0 0 0 1px #F2DCC4; }
.md-picker-head { display: flex; gap: calc(10 * var(--s)); align-items: center; }
.md-link { background: transparent; color: #E25F02; font-size: calc(20 * var(--s)); font-weight: 800; white-space: nowrap; cursor: pointer; }
.md-picker-list { display: flex; flex-direction: column; gap: calc(6 * var(--s)); max-height: calc(320 * var(--s)); overflow-y: auto; }
.md-picker-list button {
  display: flex; justify-content: space-between; align-items: center; gap: calc(10 * var(--s));
  min-height: calc(48 * var(--s)); padding: 0 calc(16 * var(--s)); border-radius: calc(16 * var(--s));
  background: #fff; color: #2E1E12; font-size: calc(21 * var(--s)); font-weight: 700; cursor: pointer; text-align: right;
}
.md-picker-list small { color: #8B7B6C; font-size: calc(18 * var(--s)); }
.md-picker .md-none { position: static; padding: calc(10 * var(--s)) 0; }

.md-esteps { display: flex; flex-direction: column; gap: calc(8 * var(--s)); }
.md-estep { display: grid; grid-template-columns: calc(46 * var(--s)) 1fr auto; align-items: center; gap: calc(10 * var(--s)); }
.md-estep i {
  width: calc(42 * var(--s)); height: calc(42 * var(--s)); border-radius: 50%; display: grid; place-items: center;
  background: linear-gradient(180deg, #FF9A1F, #F36202); color: #fff; font-style: normal; font-size: calc(24 * var(--s)); font-weight: 800;
}
.md-estep textarea { height: auto; min-height: calc(70 * var(--s)); padding: calc(8 * var(--s)) calc(12 * var(--s)); resize: vertical; line-height: 1.35; }
.md-estep-tools { display: flex; gap: calc(6 * var(--s)); }
.md-estep-tools button:not(.md-trash) {
  width: calc(42 * var(--s)); height: calc(42 * var(--s)); border-radius: 50%; background: #F4ECE3; color: #6B5646;
  font-size: calc(22 * var(--s)); font-weight: 800; cursor: pointer; padding: 0;
}
.md-estep-tools button:disabled { opacity: .35; cursor: default; }
.md-estep-tools .md-trash { width: calc(42 * var(--s)); height: calc(42 * var(--s)); }
.md-error { margin: calc(12 * var(--s)) 0 0; color: #C0392B; font-size: calc(20 * var(--s)); font-weight: 700; }
.md-eactions { display: flex; flex-wrap: wrap; gap: calc(12 * var(--s)); margin-top: calc(18 * var(--s)); }
.md-eactions button {
  height: calc(54 * var(--s)); padding: 0 calc(26 * var(--s)); border-radius: calc(27 * var(--s));
  font-size: calc(23 * var(--s)); font-weight: 800; cursor: pointer;
}
.md-eactions button:disabled { opacity: .6; cursor: default; }
.md-save { background: linear-gradient(180deg, #FF9A1F, #F36202); color: #fff; }
.md-cancel { background: #F4ECE3; color: #6B5646; }
.md-reset { margin-inline-start: auto; background: transparent; color: #C0392B; box-shadow: inset 0 0 0 1px #E8B4AD; }

.md-toast {
  position: fixed; left: 50%; bottom: calc(360 * var(--s)); transform: translateX(-50%); z-index: 60;
  padding: calc(14 * var(--s)) calc(30 * var(--s)); border-radius: calc(30 * var(--s));
  background: rgba(46, 30, 18, .92); color: #fff; font-size: calc(24 * var(--s)); font-weight: 700; white-space: nowrap;
}
