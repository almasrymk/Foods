<div class="fa-screen md" dir="rtl">
  <fa-top-bar />
  <div class="md-cv">
    <button type="button" class="md-back" (click)="location.back()" aria-label="رجوع"><fa-icon name="chevronLeft" [weight]="2.6" /></button>
    <div class="md-title">
      <img class="md-dash md-flip" src="assets/screens/shared/dash.png" alt="">
      <h1>تفاصيل الأكلة</h1>
      <img class="md-dash" src="assets/screens/shared/dash.png" alt="">
    </div>

    <!-- hero -->
    <button type="button" class="md-video" aria-label="تشغيل الفيديو">@if (heroImages.length > 1) {<fa-photo-slider [images]="heroImages" [alt]="meal.title" [fallback]="meal.video" [eager]="true" />} @else {<img [src]="meal.video" [alt]="meal.title">}</button>
    <span class="md-tag"><fa-icon name="cloche" [weight]="1.8" />{{ meal.tag }}</span>
    <h2 class="md-name">{{ meal.title }}</h2>
    <p class="md-desc">{{ meal.desc }}</p>
    <div class="md-facts">
      @for (f of meal.facts; track f.label) {
        <span><fa-icon [name]="f.icon" [filled]="!!f.filled" [weight]="1.8" />{{ f.label }}</span>
      }
    </div>

    <!-- actions -->
    <div class="md-actions">
      <button type="button" class="md-plan"><fa-icon name="calendarDays" [weight]="1.8" />إضافة إلى الخطة</button>
      <div class="fa-stepper md-qty">
        <button type="button" (click)="step(-1)" aria-label="نقص">−</button>
        <b>{{ qty }}</b>
        <button type="button" (click)="step(1)" aria-label="زيادة">+</button>
      </div>
      <i class="md-vl"></i>
      <button type="button" class="md-fav" (click)="toggleFavorite()" [disabled]="busy" [attr.aria-pressed]="favorite">
        {{ favorite ? 'في المفضلة' : 'إضافة للمفضلة' }}
        @if (favorite) { <fa-icon name="heart" [filled]="true" /> } @else { <fa-icon name="heart" [weight]="2" /> }
      </button>
    </div>

    <!-- ingredients / steps / videos: stacked from the design's top (540); same sizes, they only grow with more content -->
    <div class="md-flow">
    <!-- ingredients -->
    <section class="md-card md-ing" [class.md-editing]="editing"
             [style.height]="editing ? null : 'calc(' + (335 + ingExtra) + ' * var(--s))'">
      <h3 class="md-pill" style="width: calc(270 * var(--s))"><fa-icon name="basket" [weight]="1.9" />المكونات</h3>
      <img class="md-sdash" src="assets/screens/shared/dash.png" alt="" style="left: calc(527 * var(--s))">
      @if (!editing) {
        <div class="md-mine">
          @if (customized) { <span class="md-mine-badge">نسختك الخاصة</span> }
          @if (loaded) { <button type="button" class="md-mine-btn" (click)="startEdit()" [disabled]="saving">تعديل الأكلة ليا</button> }
        </div>
        @for (col of columns; track $index; let c = $index) {
          @for (it of col; track it.key; let r = $index) {
            <div class="md-irow" [class.md-left]="c === 1" [class.md-mark]="it.isAdded || it.isChanged"
                 [style.top]="'calc(' + (68 + r * 68) + ' * var(--s))'">
              @if (it.images.length > 1) {
                <fa-photo-slider class="md-ipic" [images]="it.images" [alt]="it.name" [fallback]="it.image" fit="contain" />
              } @else {
                <img [src]="it.image" [alt]="it.name">
              }
              <b>{{ it.name }}</b>
              <span>{{ it.qty }}</span>
            </div>
          }
        }
        @if (loaded && !columns[0].length) {
          <p class="md-none">مفيش مكونات مسجلة للأكلة دي.</p>
        }
        <i class="md-col" [style.height]="'calc(' + (215 + ingExtra) + ' * var(--s))'"></i>
      } @else {
        <div class="md-edit">
          @for (line of draftLines; track line.key; let i = $index) {
            <div class="md-erow" [class.md-new]="line.isNew">
              <img [src]="line.image" [alt]="line.name">
              <b>{{ line.name }}</b>
              <input type="number" min="0" step="any" inputmode="decimal" [(ngModel)]="line.quantity" [name]="'q' + i" aria-label="الكمية">
              <select [(ngModel)]="line.unitId" [name]="'u' + i" aria-label="الوحدة">
                @if (!unitName(line.unitId)) { <option [ngValue]="line.unitId">—</option> }
                @for (u of units; track u.id) { <option [ngValue]="u.id">{{ u.name }}</option> }
              </select>
              <button type="button" class="md-trash" (click)="removeLine(i)" [attr.aria-label]="'شيل ' + line.name"><fa-icon name="trash" [weight]="2" /></button>
            </div>
          }
          @if (removedLines.length) {
            <div class="md-removed">
              <span>اتشالت:</span>
              @for (line of removedLines; track line.key; let i = $index) {
                <button type="button" (click)="restoreLine(i)" [attr.aria-label]="'رجّع ' + line.name">{{ line.name }} ↺</button>
              }
            </div>
          }
          @if (!pickerOpen) {
            <button type="button" class="md-add" (click)="openPicker()">+ إضافة مكوّن</button>
          } @else {
            <div class="md-picker">
              <div class="md-picker-head">
                <input type="search" placeholder="دوّر على مكوّن..." [ngModel]="pickerText" (ngModelChange)="onPickerText($event)" name="picker" autofocus>
                <button type="button" class="md-link" (click)="closePicker()">إغلاق</button>
              </div>
              <div class="md-picker-list">
                @for (item of pickerResults; track item.id) {
                  <button type="button" (click)="pick(item)">
                    <span>{{ item.name }}</span><small>{{ item.unitName }}</small>
                  </button>
                }
                @if (!pickerBusy && !pickerResults.length) { <p class="md-none">مفيش نتايج.</p> }
              </div>
            </div>
          }
        </div>
      }
    </section>

    <!-- steps -->
    <section class="md-card md-steps" [class.md-editing]="editing">
      <h3 class="md-pill" style="width: calc(317 * var(--s))"><fa-icon name="chef" [weight]="1.9" />طريقة التحضير</h3>
      <img class="md-sdash" src="assets/screens/shared/dash.png" alt="" style="left: calc(487 * var(--s))">
      @if (!editing) {
        <ol>
          @for (s of steps; track $index) {
            <li><i>{{ $index + 1 }}</i><span>{{ s }}</span></li>
          }
          @if (loaded && !steps.length) {
            <li class="md-empty"><span>مفيش خطوات مكتوبة للأكلة دي.</span></li>
          }
        </ol>
      } @else {
        <div class="md-esteps">
          @for (s of draftSteps; track s.key; let i = $index; let first = $first; let last = $last) {
            <div class="md-estep">
              <i>{{ i + 1 }}</i>
              <textarea rows="2" [(ngModel)]="s.body" [name]="'s' + s.key" placeholder="اكتب الخطوة"></textarea>
              <div class="md-estep-tools">
                <button type="button" (click)="moveStep(i, -1)" [disabled]="first" aria-label="لفوق">↑</button>
                <button type="button" (click)="moveStep(i, 1)" [disabled]="last" aria-label="لتحت">↓</button>
                <button type="button" class="md-trash" (click)="removeStep(i)" aria-label="امسح الخطوة"><fa-icon name="trash" [weight]="2" /></button>
              </div>
            </div>
          }
          <button type="button" class="md-add" (click)="addStep()">+ خطوة</button>
        </div>
        @if (editError) { <p class="md-error">{{ editError }}</p> }
        <div class="md-eactions">
          <button type="button" class="md-save" (click)="save()" [disabled]="saving">{{ saving ? 'جاري الحفظ...' : 'حفظ' }}</button>
          <button type="button" class="md-cancel" (click)="cancelEdit()" [disabled]="saving">إلغاء</button>
          @if (customized) {
            <button type="button" class="md-reset" (click)="resetToOriginal()" [disabled]="saving">رجوع للأصل</button>
          }
        </div>
      }
    </section>

    <!-- videos -->
    <section class="md-card md-videos">
      <h3 class="md-pill" style="width: calc(422 * var(--s))"><fa-icon name="play" [weight]="1.9" />فيديوهات طريقة العمل</h3>
      <img class="md-sdash" src="assets/screens/shared/dash.png" alt="" style="left: calc(378 * var(--s))">
      <div class="md-thumbs">
        @for (v of meal.videos; track v.label) {
          <button type="button" class="md-thumb"><img [src]="v.image" [alt]="v.label"><b>{{ v.label }}</b></button>
        }
      </div>
    </section>
    </div>
  </div>
  <fa-tab-bar />
</div>
