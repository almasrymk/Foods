export interface ApiResult<T> {
  statusCode: number;
  response: T | null;
  errors: string[] | null;
}

export interface AuthUser {
  id: string;
  name: string;
  userName: string;
  imagePath?: string | null;
  token: string;
  role?: string | null;
}

export interface Profile {
  countryId?: string | null;
  countryName?: string | null;
  dialect?: string | null;
  name?: string | null;
  userName?: string | null;
}

export interface FamilyMemberInput {
  name: string;
  age: number;
  birthDate?: string | null;
}

export interface FamilyMember {
  id: string;
  name?: string | null;
  age: number;
  birthDate?: string | null;
}

export interface UserSettings {
  language: 'ar' | 'en';
  notifyLogin: boolean;
  notifyWelcome: boolean;
  notifyBirthday: boolean;
  notifyOrders: boolean;
  notifyPlanning: boolean;
}

export interface AppNotification {
  id: string;
  type: string;
  title?: string | null;
  body?: string | null;
  link?: string | null;
  createdAt: string;
  readAt?: string | null;
}

export interface NotificationPage {
  items: AppNotification[];
  total: number;
  unread: number;
}

export interface MealCard {
  id: string;
  name?: string | null;
  description?: string | null;
  imagePath?: string | null;
  iconPath?: string | null;
  color?: string | null;
  textColor?: string | null;
  sort?: number | null;
}

export interface ItemCard {
  id: string;
  name?: string | null;
  summary?: string | null;
  imagePath?: string | null;
  isFavorite: boolean;
  countryName?: string | null;
  dialect?: string | null;
  categoryId?: string | null;
  categoryName?: string | null;
  cuisineId?: string | null;
  cuisineName?: string | null;
  /** Main photo first, then the album. */
  images?: string[];
}

export interface MealItemFilter {
  id?: string | null;
  name: string;
  count: number;
  iconPath?: string | null;
  color?: string | null;
  textColor?: string | null;
}

export interface ItemIngredient {
  contentId: string;
  name?: string | null;
  imagePath?: string | null;
  unitId: string;
  unitName?: string | null;
  quantity: number;
  purchasePlaceId?: string | null;
  purchasePlaceName?: string | null;
  images?: string[];
  /** Personal version (نسختك الخاصة): added by the customer / quantity or unit changed. */
  isAdded?: boolean;
  isChanged?: boolean;
}

export interface ItemStep {
  sort: number;
  body?: string | null;
}

export interface ItemVideo {
  sort: number;
  title?: string | null;
  url?: string | null;
}

export interface ItemDetail {
  id: string;
  name?: string | null;
  summary?: string | null;
  description?: string | null;
  imagePath?: string | null;
  isFavorite: boolean;
  countryName?: string | null;
  dialect?: string | null;
  ingredients: ItemIngredient[];
  steps: ItemStep[];
  videos: ItemVideo[];
  images?: string[];
  /** The current customer changed this dish for themselves. */
  isCustomized?: boolean;
}

/** The customer's own version of a dish (GET/PUT/DELETE customer/items/{id}/mine). */
export interface MyItemRecipe {
  itemId: string;
  isCustomized: boolean;
  stepsCustomized: boolean;
  lines: ItemIngredient[];
  removed: ItemIngredient[];
  steps: ItemStep[];
}

export interface MyLineInput {
  contentId: string;
  unitId: string;
  quantity: number;
  removed?: boolean;
}

export interface ContentPick {
  id: string;
  name?: string | null;
  imagePath?: string | null;
  unitId: string;
  unitName?: string | null;
  miniQuantity: number;
}

export interface UnitPick {
  id: string;
  name?: string | null;
}

export interface ContentPickResult {
  items: ContentPick[];
  units: UnitPick[];
}

export interface SelectedItem {
  itemId: string;
  name: string;
  imagePath?: string | null;
  repeatCount: number;
  peopleCount: number | null;
}

export interface ShoppingLine {
  contentId: string;
  name?: string | null;
  imagePath?: string | null;
  purchasePlaceId?: string | null;
  purchasePlaceName?: string | null;
  unitId: string;
  unitName?: string | null;
  quantity: number;
  /** أقل وحدة شراء: 0 normal, 1 package, 2 kilo fractions, 3 money (see core/purchase.ts). */
  purchaseMode?: number;
  packageName?: string | null;
  purchaseStep?: number;
  purchaseIncrement?: number;
  /** Mode 4: price of 1/8 kg (one purchaseStep) and the least money amount. */
  purchaseUnitPrice?: number;
  purchaseMinAmount?: number;
  images?: string[];
}

/** 0 draft, 1 temporary save (حفظ مؤقت), 2 confirmed (محفوظ). */
export type OrderStatusCode = 0 | 1 | 2;

export interface OrderListItem {
  id: string;
  name?: string | null;
  date: string;
  status?: OrderStatusCode | number;
}

export interface OrderItem {
  itemId: string;
  name?: string | null;
  imagePath?: string | null;
  repeatCount: number;
  peopleCount?: number | null;
}

export interface OrderDetail {
  id: string;
  name?: string | null;
  date: string;
  notes?: string | null;
  status?: OrderStatusCode | number;
  items: OrderItem[];
  lines: ShoppingLine[];
}

/** Old-orders state: إنشاء بدون طباعة / تم الطباعة / أعيد طلبه. */
export type OrderHistoryState = 'created' | 'printed' | 'reordered' | 'shared';

export interface OrderHistoryDish {
  itemId: string;
  name?: string | null;
  imagePath?: string | null;
  repeatCount: number;
}

export interface OrderHistoryItem {
  id: string;
  name?: string | null;
  code?: string | null;
  date: string;
  createdAt?: string | null;
  state: OrderHistoryState;
  printedAt?: string | null;
  reorderedAt?: string | null;
  sharedAt?: string | null;
  dishCount: number;
  lineCount: number;
  dishes: OrderHistoryDish[];
}

export interface OrderHistoryCounts { all: number; created: number; printed: number; reordered: number; shared: number; }

export interface OrderHistoryPage {
  items: OrderHistoryItem[];
  total: number;
  hasMore: boolean;
  counts: OrderHistoryCounts;
}

export interface OrderHistoryFilter {
  text?: string;
  state?: OrderHistoryState | '';
  from?: string;
  to?: string;
  dish?: string;
}
