@{
    Layout = null;

    var mealTimes = new[]
    {
        new { Key = "breakfast", Title = "الفطار", Icon = "sun" },
        new { Key = "lunch", Title = "الغداء", Icon = "cloche" },
        new { Key = "dinner", Title = "العشاء", Icon = "moon" },
        new { Key = "snacks", Title = "وجبات خفيفة", Icon = "basket" },
    };

    var cuisines = new[]
    {
        new { Key = "east", Title = "شرقي" },
        new { Key = "west", Title = "غربي" },
        new { Key = "healthy", Title = "صحي" },
        new { Key = "vegan", Title = "نباتي" },
        new { Key = "dessert", Title = "حلويات" },
    };

    var meals = new[]
    {
        new { Id = 1, Name = "كشري مصري", Image = "meal-koshari.jpg", Minutes = 60, Servings = 4, Favorite = false, Qty = 0 },
        new { Id = 2, Name = "محشي ورق عنب", Image = "meal-warak-enab.jpg", Minutes = 90, Servings = 4, Favorite = true, Qty = 2 },
        new { Id = 3, Name = "دجاج مشوي بالأعشاب", Image = "meal-grilled-chicken.jpg", Minutes = 45, Servings = 4, Favorite = false, Qty = 0 },
        new { Id = 4, Name = "بولة دجاج بالخضار", Image = "meal-chicken-bowl.jpg", Minutes = 30, Servings = 2, Favorite = false, Qty = 0 },
    };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#fef9f0">
    <title>Foods - الرئيسية</title>
    <link rel="shortcut icon" href="~/assets/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/home/home.css" asp-append-version="true">
</head>
<body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="7.2" r="4.6" fill="currentColor"/><path d="M3.2 21.5c0-4.6 3.9-7.6 8.8-7.6s8.8 3 8.8 7.6c0 .5-.4.9-.9.9H4.1c-.5 0-.9-.4-.9-.9z" fill="currentColor"/></symbol>
        <symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.6 1.8H4.4z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="M10 20.4a2.2 2.2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M12 3v2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M15.5 15.5l5 5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/></symbol>
        <symbol id="i-mic" viewBox="0 0 24 24"><rect x="8.6" y="2.5" width="6.8" height="12" rx="3.4" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5M8.5 21.5h7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
        <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.9"/><g stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></symbol>
        <symbol id="i-cloche" viewBox="0 0 24 24"><path d="M3.5 17h17M4.8 17a7.2 7.2 0 0 1 14.4 0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M12 9.8V8M10.5 7.4h3M2.8 20h18.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
        <symbol id="i-moon" viewBox="0 0 24 24"><path d="M19.5 14.8A8 8 0 0 1 9.2 4.5a8 8 0 1 0 10.3 10.3z" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/><path d="M15.5 3.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6zM19.6 8.2l.4.9.9.4-.9.4-.4.9-.4-.9-.9-.4.9-.4z" fill="currentColor"/></symbol>
        <symbol id="i-basket" viewBox="0 0 24 24"><path d="M3.2 10h17.6l-1.6 9.2a1.8 1.8 0 0 1-1.8 1.5H6.6a1.8 1.8 0 0 1-1.8-1.5z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><path d="M7.5 10l3-6M16.5 10l-3-6M9 13.5v4M12 13.5v4M15 13.5v4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
        <symbol id="i-chevron" viewBox="0 0 24 24"><path d="M14.5 5.5L8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.2" y="4.8" width="17.6" height="15.8" rx="2.6" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M3.2 9.6h17.6M8 2.8v4M16 2.8v4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><g fill="currentColor"><circle cx="8" cy="13.2" r="1.1"/><circle cx="12" cy="13.2" r="1.1"/><circle cx="16" cy="13.2" r="1.1"/><circle cx="8" cy="16.8" r="1.1"/><circle cx="12" cy="16.8" r="1.1"/></g></symbol>
        <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20.3s-7.8-4.6-8.9-10A4.9 4.9 0 0 1 12 6.6a4.9 4.9 0 0 1 8.9 3.7c-1.1 5.4-8.9 10-8.9 10z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7.4V12l3 1.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="i-person" viewBox="0 0 24 24"><circle cx="12" cy="7.8" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4.5 20.5c0-3.8 3.4-6.3 7.5-6.3s7.5 2.5 7.5 6.3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5.5v13M5.5 12h13" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/></symbol>
        <symbol id="i-minus" viewBox="0 0 24 24"><path d="M5.5 12h13" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/></symbol>
        <symbol id="i-badge" viewBox="0 0 24 24"><path d="M12 1.8l2.6 1.9 3.2-.1 1 3 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3-3.2-.1L12 22.2l-2.6-1.9-3.2.1-1-3-2.6-1.9 1-3.1-1-3.1 2.6-1.9 1-3 3.2.1z" fill="currentColor"/><path d="M8.2 12.2l2.6 2.6 5-5.2" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="i-home" viewBox="0 0 24 24"><path d="M12 2.6L1.8 11.2a1 1 0 0 0 .7 1.8H4v7.6c0 .6.5 1 1 1h4.6v-6.2h4.8v6.2H19c.5 0 1-.4 1-1V13h1.5a1 1 0 0 0 .7-1.8z" fill="currentColor"/></symbol>
        <symbol id="i-heart-o" viewBox="0 0 24 24"><path d="M12 20.3s-7.8-4.6-8.9-10A4.9 4.9 0 0 1 12 6.6a4.9 4.9 0 0 1 8.9 3.7c-1.1 5.4-8.9 10-8.9 10z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></symbol>
        <symbol id="i-cart" viewBox="0 0 24 24"><path d="M2.6 9.4h18.8l-1.8 10a2 2 0 0 1-2 1.6H6.4a2 2 0 0 1-2-1.6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M7 9.4l3.4-6.4M17 9.4l-3.4-6.4M8.4 12.8v5M12 12.8v5M15.6 12.8v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
        <symbol id="i-orders" viewBox="0 0 24 24"><path d="M5.5 2.8h10.2l3.3 3.3v13.6a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 4 19.7V4.3a1.5 1.5 0 0 1 1.5-1.5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M7.6 8.6h6M7.6 12h8.8M7.6 15.4h5.2M15.6 15.4h1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></symbol>
        <symbol id="i-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M10.3 2.6h3.4l.5 2.5 1.6.9 2.4-.9 1.7 3-1.9 1.6v1.9l1.9 1.6-1.7 3-2.4-.9-1.6.9-.5 2.5h-3.4l-.5-2.5-1.6-.9-2.4.9-1.7-3 1.9-1.6v-1.9L4.1 8.1l1.7-3 2.4.9 1.6-.9z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></symbol>
    </svg>

    <div class="app">
        <img class="hero-art" src="~/home/img/hero.jpg" alt="" aria-hidden="true">

        <header class="top">
            <a class="avatar" href="#" aria-label="الملف الشخصي">
                <svg><use href="#i-user"/></svg>
                <span class="avatar-dot"></span>
            </a>
            <a class="logo" href="@Url.Action("Index", "Home")" aria-label="Foods">
                <img src="~/home/img/logo.png" alt="Foods">
            </a>
            <a class="bell" href="#" aria-label="الإشعارات">
                <svg><use href="#i-bell"/></svg>
                <span class="bell-badge">3</span>
            </a>
        </header>

        <section class="welcome">
            <h1>مرحباً بك <img src="~/home/img/wave.png" alt="" class="wave"></h1>
            <p>استمتع بوجبة أسهل وأصح</p>
        </section>

        <form class="search" role="search" onsubmit="return false">
            <button type="submit" class="search-btn" aria-label="بحث"><svg><use href="#i-search"/></svg></button>
            <input type="search" placeholder="ابحث عن أكلة، وصفة، مكون ..." aria-label="ابحث عن أكلة، وصفة، مكون">
            <button type="button" class="mic-btn" aria-label="بحث صوتي"><svg><use href="#i-mic"/></svg></button>
        </form>

        <nav class="meal-times" aria-label="أوقات الوجبات">
            @foreach (var m in mealTimes)
            {
                <a href="#" class="meal-time meal-time--@m.Key" style="background-image:url('@Url.Content($"~/home/img/cat-{m.Key}.jpg")')">
                    <svg class="meal-time-icon"><use href="#i-@m.Icon"/></svg>
                    <span>@m.Title</span>
                </a>
            }
        </nav>

        <section class="plan">
            <img class="plan-art" src="~/home/img/banner-art.jpg" alt="">
            <div class="plan-body">
                <h2>خطط لأكل الشهر</h2>
                <p>اختر أكلاتك، وحدد عدد التكرار،<br>ونحن نحسب لك المكونات تلقائياً</p>
                <a href="#" class="plan-cta">
                    <svg class="plan-cta-cal"><use href="#i-calendar"/></svg>
                    <span>ابدأ التخطيط الآن</span>
                    <svg class="plan-cta-chev"><use href="#i-chevron"/></svg>
                </a>
            </div>
        </section>

        <section class="block">
            <div class="block-head">
                <h3>تصفح حسب المطبخ</h3>
                <a href="#" class="see-all">عرض الكل <svg><use href="#i-chevron"/></svg></a>
            </div>
            <div class="cuisines">
                @foreach (var c in cuisines)
                {
                    <a href="#" class="cuisine" style="background-image:url('@Url.Content($"~/home/img/cuisine-{c.Key}.jpg")')">
                        <span>@c.Title</span>
                    </a>
                }
            </div>
        </section>

        <section class="block block--meals">
            <div class="block-head">
                <h3><svg class="verified"><use href="#i-badge"/></svg>أكلات مقترحة لك</h3>
                <a href="#" class="see-all">عرض الكل <svg><use href="#i-chevron"/></svg></a>
            </div>
            <div class="meals">
                @foreach (var meal in meals)
                {
                    <article class="meal" data-id="@meal.Id">
                        <div class="meal-photo" style="background-image:url('@Url.Content($"~/home/img/{meal.Image}")')">
                            <button type="button" class="fav @(meal.Favorite ? "is-on" : "")" aria-pressed="@(meal.Favorite ? "true" : "false")" aria-label="إضافة للمفضلة">
                                <svg><use href="#i-heart"/></svg>
                            </button>
                        </div>
                        <h4>@meal.Name</h4>
                        <div class="meal-meta">
                            <span><svg><use href="#i-clock"/></svg>@meal.Minutes د</span>
                            <span>@meal.Servings<svg><use href="#i-person"/></svg></span>
                        </div>
                        <div class="qty @(meal.Qty > 0 ? "has-qty" : "")" data-qty="@meal.Qty">
                            <button type="button" class="qty-plus" aria-label="زيادة"><svg><use href="#i-plus"/></svg></button>
                            <span class="qty-val">@meal.Qty</span>
                            <button type="button" class="qty-minus" aria-label="تقليل"><svg><use href="#i-minus"/></svg></button>
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>

    <nav class="tabbar" aria-label="القائمة الرئيسية">
        <a href="@Url.Action("Index", "Home")" class="tab is-active"><svg><use href="#i-home"/></svg><span>الرئيسية</span></a>
        <a href="#" class="tab"><svg><use href="#i-heart-o"/></svg><span>المفضلة</span></a>
        <a href="#" class="tab tab--center"><svg><use href="#i-cart"/></svg><span>طباتي</span></a>
        <a href="#" class="tab"><svg><use href="#i-orders"/></svg><span>قائمة الطلبات</span></a>
        <a href="#" class="tab"><svg><use href="#i-settings"/></svg><span>الإعدادات</span></a>
    </nav>

    <script src="~/home/home.js" asp-append-version="true"></script>
</body>
</html>
