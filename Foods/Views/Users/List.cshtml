@model X.PagedList.IPagedList<FoodEntity.Models.User>
@using X.PagedList.Mvc.Core;
@using X.PagedList.Mvc.Core.Fluent;
@using X.PagedList.Web.Common;




<div class="table-responsive">
    <table class="table border-0 star-student table-hover table-center mb-0  table-striped">
        <thead class="student-thread">
            <tr>
                <th style="width:40px;">#</th>
                <th>@FoodEntity.Resources.Title.Name</th>
                <th>@FoodEntity.Resources.Title.Mail</th>
                <th style="width:50px;"></th>
            </tr>
        </thead>
        <tbody>
            @{
                var index = 0;
                foreach (var Item in Model)
                {
                    index++;
                    <tr>
                        <td>@index</td>
                        <td>
                            <h2 class="table-avatar">
                                <a class="avatar avatar-sm me-2"><img class="avatar-img rounded-circle" src="~/assets/img/profiles/avatar-01.jpg" alt="User Image"></a>
                                <a>@Item.FullName</a>
                            </h2>
                        </td>
                        <td>@Item.Email</td>
                        <td class="text-end">
                            <div class="actions ">
                                <a href="javascript:;" class="btn btn-sm bg-success-light me-2 ">
                                    <i class="feather-eye"></i>
                                </a>
                                <a href=@("/Users/Save/" + Item.Id) class="btn btn-sm bg-danger-light me-2">
                                    <i class="feather-edit"></i>
                                </a>

                                <a href=@("/Users/Delete/" + Item.Id) class="btn btn-sm bg-danger-light">
                                    <i class="far fa-trash-alt me-1 text-danger"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="row">
        <div class=" col-sm-12 col-md-7">
            @if (Model.PageCount > 1)
            {
                @(Html.Pager(Model)
                    .Url(page => Url?.Action("Index", new { page }))
                    .WithPartialView("_Pager_85")
                    .DisplayLinkToFirstPage(PagedListDisplayMode.Never)
                    .DisplayLinkToLastPage(PagedListDisplayMode.Never)
                    .DisplayLinkToPreviousPage()
                    .DisplayLinkToNextPage()
                    .MaximumPageNumbersToDisplay(5)
                    .DisplayPageCountAndCurrentLocation(true)
                    .Build())
            }
        </div>
        @*<select class="w-20 form-select box mt-3 sm:mt-0">
        <option>10</option>
        <option>25</option>
        <option>35</option>
        <option>50</option>
        </select>*@
    </div>







</div>