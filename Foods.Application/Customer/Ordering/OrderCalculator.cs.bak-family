namespace Foods.Application.Customer.Ordering
{
    using Microsoft.EntityFrameworkCore;
    using Foods.Domain.Abstraction;
    using Foods.Domain.Entity.Security;
    using Foods.Domain.Entity.MasterData;
    using Foods.Domain.Entity.MasterData.Item;
    using Foods.Domain.Entity.MasterData.Content;

    public interface IOrderCalculator
    {
        Task<IReadOnlyList<ShoppingLineResult>> CalculateAsync(Guid userId, IReadOnlyList<ItemSelection> items, CancellationToken cancellationToken);
        Task<decimal> PeopleFactorAsync(Guid userId, int? peopleCount, CancellationToken cancellationToken);
    }

    public sealed class OrderCalculator(IFoodsDbContext db) : IOrderCalculator
    {
        public async Task<IReadOnlyList<ShoppingLineResult>> CalculateAsync(Guid userId, IReadOnlyList<ItemSelection> items, CancellationToken cancellationToken)
        {
            if (items == null || items.Count == 0)
                return Array.Empty<ShoppingLineResult>();

            var itemIds = items.Select(e => e.ItemId).Distinct().ToList();
            // Each customer gets their own version of a dish (removed / changed / added ingredients); others are not affected.
            var recipe = await Foods.Application.Customer.Catalog.PersonalRecipe.Lines(db, userId, itemIds, cancellationToken);

            var contentIds = recipe.Select(e => e.ContentId).Distinct().ToList();
            var contents = await db.Contents
                .Where(e => contentIds.Contains(e.Id) && !e.IsDeleted)
                .ToListAsync(cancellationToken);
            var unitIds = recipe.Select(e => e.UnitId).Distinct().ToList();
            var units = await db.Units.Where(e => unitIds.Contains(e.Id)).ToListAsync(cancellationToken);
            var placeIds = contents.Where(e => e.PurchasePlaceId != null).Select(e => e.PurchasePlaceId!.Value).Distinct().ToList();
            var places = await db.PurchasePlaces.Where(e => placeIds.Contains(e.Id)).ToListAsync(cancellationToken);
            var family = await db.Set<FamilyMember>().Where(e => e.UserId == userId && !e.IsDeleted).ToListAsync(cancellationToken);
            var bands = await db.AgeBands.Where(e => !e.IsDeleted).ToListAsync(cancellationToken);
            var household = HouseholdFactor(family, bands);

            var totals = new Dictionary<(Guid ContentId, Guid UnitId), decimal>();
            foreach (var item in items)
            {
                var repeat = item.RepeatCount <= 0 ? 1 : item.RepeatCount;
                var people = item.PeopleCount is int count && count > 0 ? count : household;
                foreach (var line in recipe.Where(e => e.ItemId == item.ItemId))
                {
                    var key = (line.ContentId, line.UnitId);
                    totals[key] = totals.GetValueOrDefault(key) + (line.Quantity * repeat * people);
                }
            }

            var albums = await Foods.Application.Customer.Catalog.AlbumImages.ForContents(db, contents.Select(e => (e.Id, e.ImagePath)), cancellationToken);

            return totals.Select(pair =>
            {
                var content = contents.FirstOrDefault(e => e.Id == pair.Key.ContentId);
                var unit = units.FirstOrDefault(e => e.Id == pair.Key.UnitId);
                var place = content?.PurchasePlaceId == null ? null : places.FirstOrDefault(e => e.Id == content.PurchasePlaceId);
                var mode = content?.PurchaseMode ?? 0;
                var step = content?.PurchaseStep ?? 0;
                return new ShoppingLineResult(
                    pair.Key.ContentId,
                    content?.Name,
                    content?.ImagePath,
                    content?.PurchasePlaceId,
                    place?.Name,
                    pair.Key.UnitId,
                    unit?.Name,
                    PurchaseRules.Round(mode, step, pair.Value, content?.PurchaseUnitPrice ?? 0, content?.PurchaseMinAmount ?? 0, content?.PurchaseIncrement ?? 0),
                    mode,
                    content?.PackageName,
                    PurchaseRules.Step(mode, step),
                    content?.PurchaseIncrement ?? 0,
                    Foods.Application.Customer.Catalog.AlbumImages.Of(albums, pair.Key.ContentId, content?.ImagePath),
                    content?.PurchaseUnitPrice ?? 0,
                    content?.PurchaseMinAmount ?? 0);
            }).OrderBy(e => e.PurchasePlaceName).ThenBy(e => e.Name).ToList();
        }

        public async Task<decimal> PeopleFactorAsync(Guid userId, int? peopleCount, CancellationToken cancellationToken)
        {
            if (peopleCount is int count && count > 0)
                return count;

            var family = await db.Set<FamilyMember>().Where(e => e.UserId == userId && !e.IsDeleted).ToListAsync(cancellationToken);
            var bands = await db.AgeBands.Where(e => !e.IsDeleted).ToListAsync(cancellationToken);
            return HouseholdFactor(family, bands);
        }

        public static decimal HouseholdFactor(IReadOnlyList<FamilyMember> members, IReadOnlyList<AgeBand> bands)
        {
            if (members.Count == 0)
                return 1m;

            return members.Sum(member =>
            {
                var band = bands.FirstOrDefault(e => member.Age >= e.MinAge && member.Age <= e.MaxAge);
                return band?.Factor ?? 1m;
            });
        }
    }
}
