    public sealed record GetMealsQuery() : IQuery<List<MealCard>>;
    public sealed record MealCard(Guid Id, string? Name, string? Description, string? ImagePath, string? IconPath, string? Color, string? TextColor, int Sort);

    public sealed class GetMealsQueryHandler(IFoodsDbContext db) : IQueryHandler<GetMealsQuery, List<MealCard>>
    {
        public async Task<Result<List<MealCard>>> Handle(GetMealsQuery request, CancellationToken cancellationToken)
        {
            var meals = await db.Meals
                .Where(e => !e.IsDeleted)
                .OrderBy(e => e.Sort)
                .ThenBy(e => e.Name)
                .Select(e => new MealCard(e.Id, e.Name, e.Description, e.ImagePath, e.IconPath, e.Color, e.TextColor, e.Sort))
                .ToListAsync(cancellationToken);

            return new Result<List<MealCard>>(HttpStatusCode.OK, meals, null);
        }
    }

