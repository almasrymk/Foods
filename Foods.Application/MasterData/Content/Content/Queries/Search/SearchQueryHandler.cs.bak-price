namespace Foods.Application.MasterData.Content.Content.Queries.Search
{
    using Foods.Domain.Shared;
    using Foods.Domain.Abstraction;
    using Foods.Application.Abstraction.Query;
    using Foods.Domain.Entity.MasterData.Content;

    public class SearchQueryHandler(IRepository<Content> _Repository) : IQueryHandler<SearchQuery, List<SearchQueryResponse>>
    {
        public async Task<Result<List<SearchQueryResponse>>> Handle(SearchQuery request, CancellationToken cancellationToken)
        {
            var list = await _Repository.GetListByFilterAsync(e => 
            (("" + e.Name).ToLower().Contains(("" + request.TextSearch).ToLower()) || "" + request.TextSearch == "") &&
            (e.ContentCategoryId == request.ContentCategoryId || request.ContentCategoryId == null) &&
            (e.ContentGroupId == request.ContentGroupId || request.ContentGroupId == null)           
            );

            if (list == null)
                list = new List<Content>();

            return new Result<List<SearchQueryResponse>>(System.Net.HttpStatusCode.OK,
                list.Select(e => new SearchQueryResponse(
                    e.Id,
                    e.Name!,
                    e.ContentCategoryId,
                    e.ContentGroupId,
                    e.UnitId,
                    e.MiniQuantity,
                    e.ImagePath,
                    e.PurchasePlaceId,
                    e.PurchaseMode,
                    e.PackageName,
                    e.PurchaseStep,
                    e.PurchaseIncrement
                    )).ToList(), null);
        }
    }
}